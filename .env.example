# URL del webhook de n8n que expone el flujo de análisis multimodal.
#
# IMPORTANTE: es un secreto de SERVIDOR. No debe llevar el prefijo VITE_,
# porque Vite incrustaría su valor en el bundle del navegador y quedaría
# visible para cualquier visitante.
N8N_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/prl-audit

# Opcional: si el webhook de n8n exige autenticación por cabecera, define el
# token aquí. Se envía como cabecera `x-webhook-token`.
# N8N_WEBHOOK_TOKEN=
